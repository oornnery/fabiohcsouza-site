# Development settings: copy to .env. Every value is optional; these are the defaults.
# Production: docker/.env.example. Comments only on their own line (Docker reads this file too).

# empty: both sites in one process; production runs one per container (portfolio | blog)
SITE=
# the portfolio links to the blog (menu, footer, home, RSS); false in production until the blog is live
BLOG=true
# fake posts from dev/demo-posts.json, to try lists and pages (up to 220)
DEMO_POSTS=0
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///.local/app.sqlite
PORTFOLIO_URL=http://portfolio.localhost:8000
BLOG_URL=http://blog.localhost:8000

# E-mail. Without SMTP_HOST nothing is sent: the log says so, and shows the newsletter's confirm link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
OWNER_EMAIL=
SECRET_KEY=

# Cloudflare (optional): Turnstile on the forms (both or neither), Web Analytics
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CF_ANALYTICS_TOKEN=

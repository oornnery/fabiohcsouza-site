# Settings. Copy to .env (chmod 600 in production): it never goes to git nor into the image.
# These are the development values: both sites on http://portfolio.localhost:8000 and http://blog.localhost:8000,
# e-mails only written to the log. Development needs no .env at all; copy only what you want to change.
# Production (docker/compose.yml) reads .env at the root and refuses to start while something is missing or insecure
# (https URLs, SMTP, EMAIL_FROM, OWNER_EMAIL, SECRET_KEY); the log says why.
# Docker reads this file as is: comments only on their own line, never after a value.

PORTFOLIO_URL=http://portfolio.localhost:8000
BLOG_URL=http://blog.localhost:8000
# true once the blog is live: the portfolio then links to it
BLOG=false
# the blog's newsletter (form, /subscribe); false hides it, links already sent keep working
NEWSLETTER=true
# the header with the visitor's IP set by the proxy in front (behind Cloudflare: cf-connecting-ip); empty = socket address
CLIENT_IP_HEADER=
# true: pages and forms answer 503, the health check stays up
MAINTENANCE=false

# E-mail over SMTP. Empty SMTP_HOST: e-mails are only logged. 587 = STARTTLS, 465 = TLS from the first byte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# the sender, an address the SMTP user may send as: Name <address>
EMAIL_FROM=
# where contact messages go
OWNER_EMAIL=

# Blog: signs the newsletter links. 32+ characters; changing it breaks links already sent.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Cloudflare Turnstile on the forms (both or neither)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Web Analytics (optional, cookieless): the token of the site's snippet
CF_ANALYTICS_TOKEN=

# Limits (these are the defaults)
PAGE_LIMIT_PER_MINUTE=240
FORM_LIMIT=5
FORM_WINDOW_SECONDS=600
